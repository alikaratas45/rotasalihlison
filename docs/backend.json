{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "displayName": {
          "type": "string"
        },
        "photoURL": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": [
        "uid",
        "email"
      ]
    },
    "Place": {
      "title": "Place",
      "description": "A location of interest.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "name": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "description": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "category": {
          "type": "string",
          "enum": [
            "history",
            "nature",
            "food",
            "shopping",
            "poi"
          ]
        },
        "coordinates": {
          "$ref": "#/backend/entities/Coordinates"
        },
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageHint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "category",
        "coordinates"
      ]
    },
    "Route": {
      "title": "Route",
      "description": "A thematic route with multiple stops.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "name": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "description": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "stops": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "id",
        "slug",
        "name",
        "description",
        "stops"
      ]
    },
    "Story": {
      "title": "Story",
      "description": "A story or legend related to a place.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "title": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "author": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "content": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "placeId": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "slug",
        "title",
        "author",
        "content"
      ]
    },
    "Brochure": {
      "title": "Brochure",
      "description": "A digital brochure with multiple pages.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "pages": {
          "type": "array",
          "items": {
            "$ref": "#/backend/entities/BrochurePage"
          }
        }
      },
      "required": [
        "id",
        "title",
        "pages"
      ]
    },
    "BrochurePage": {
      "title": "Brochure Page",
      "description": "A single page within a brochure.",
      "type": "object",
      "properties": {
        "imageUrl": {
          "type": "string",
          "format": "uri"
        },
        "imageHint": {
          "type": "string"
        },
        "title": {
          "$ref": "#/backend/entities/LocalizedString"
        },
        "text": {
          "$ref": "#/backend/entities/LocalizedString"
        }
      },
      "required": [
        "imageUrl",
        "imageHint"
      ]
    },
    "MenuItem": {
      "title": "Menu Item",
      "description": "An item in the main navigation menu.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "labelKey": {
          "type": "string",
          "description": "The key for the translation file (e.g., 'header.places')."
        },
        "href": {
          "type": "string"
        },
        "order": {
          "type": "number"
        }
      },
      "required": [
        "id",
        "labelKey",
        "href",
        "order"
      ]
    },
    "LocalizedString": {
      "title": "Localized String",
      "description": "A string that can be localized into multiple languages.",
      "type": "object",
      "properties": {
        "tr": {
          "type": "string"
        },
        "en": {
          "type": "string"
        },
        "fr": {
          "type": "string"
        },
        "de": {
          "type": "string"
        }
      },
      "required": [
        "tr",
        "en"
      ]
    },
    "Coordinates": {
      "title": "Coordinates",
      "description": "Geographical coordinates.",
      "type": "object",
      "properties": {
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lng"
      ]
    }
  },
  "auth": {
    "providers": [
      "google.com"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/backend/entities/UserProfile"
      },
      "description": "Stores user profile information."
    },
    "/places": {
      "schema": {
        "$ref": "#/backend/entities/Place"
      },
      "description": "Collection of all places of interest."
    },
    "/routes": {
      "schema": {
        "$ref": "#/backend/entities/Route"
      },
      "description": "Collection of all thematic routes."
    },
    "/stories": {
      "schema": {
        "$ref": "#/backend/entities/Story"
      },
      "description": "Collection of all stories and legends."
    },
    "/brochures": {
      "schema": {
        "$ref": "#/backend/entities/Brochure"
      },
      "description": "Collection of all brochures."
    },
    "/menu-items": {
      "schema": {
        "$ref": "#/backend/entities/MenuItem"
      },
      "description": "Collection of main navigation menu items."
    }
  }
}
