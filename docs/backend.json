
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string", "format": "uri" },
        "isAdmin": { "type": "boolean" }
      },
      "required": ["uid", "email"]
    },
    "Place": {
      "title": "Place",
      "description": "A location of interest.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "$ref": "#/backend/entities/LocalizedString" },
        "name": { "$ref": "#/backend/entities/LocalizedString" },
        "description": { "$ref": "#/backend/entities/LocalizedString" },
        "category": { "type": "string", "enum": ["history", "nature", "food", "shopping", "poi"] },
        "coordinates": { "$ref": "#/backend/entities/Coordinates" },
        "imageUrl": { "type": "string", "format": "uri" },
        "imageHint": { "type": "string" },
        "subPoints": {
          "type": "array",
          "items": { "$ref": "#/backend/entities/SubPoint" }
        }
      },
      "required": ["id", "slug", "name", "description", "category", "coordinates"]
    },
    "SubPoint": {
      "title": "Sub Point",
      "description": "A specific section or point of interest within a larger place.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "$ref": "#/backend/entities/LocalizedString" },
        "description": { "$ref": "#/backend/entities/LocalizedString" },
        "coordinates": { "$ref": "#/backend/entities/Coordinates" }
      },
      "required": ["id", "name", "description", "coordinates"]
    },
    "Feedback": {
      "title": "Feedback",
      "description": "User feedback for a specific place.",
      "type": "object",
      "properties": {
        "placeId": { "type": "string" },
        "placeName": { "type": "string" },
        "cleanliness": { "type": "number" },
        "accessibility": { "type": "number" },
        "satisfaction": { "type": "number" },
        "withTour": { "type": "string", "enum": ["yes", "no"] },
        "guided": { "type": "string", "enum": ["yes", "no"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["placeId", "cleanliness", "accessibility", "satisfaction", "withTour", "guided"]
    },
    "CommentFeedback": {
      "title": "Comment Feedback",
      "description": "General user comments for the guestbook.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "message": { "type": "string" },
        "likes": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "replies": {
          "type": "array",
          "items": { "$ref": "#/backend/entities/CommentReply" }
        }
      },
      "required": ["message", "createdAt"]
    },
    "CommentReply": {
      "title": "Comment Reply",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["message", "createdAt"]
    },
    "Route": {
      "title": "Route",
      "description": "A thematic route with multiple stops.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "$ref": "#/backend/entities/LocalizedString" },
        "name": { "$ref": "#/backend/entities/LocalizedString" },
        "description": { "$ref": "#/backend/entities/LocalizedString" },
        "stops": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "slug", "name", "description", "stops"]
    },
    "ExperienceItem": {
      "title": "Experience Item",
      "description": "An item in the 'A Day in Salihli' experience menu on the home page.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "$ref": "#/backend/entities/LocalizedString" },
        "icon": { "type": "string", "description": "The name of the lucide-react icon to display." },
        "link": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "name", "icon", "link", "order"]
    },
    "Story": {
      "title": "Story",
      "description": "A story or legend related to a place.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "$ref": "#/backend/entities/LocalizedString" },
        "title": { "$ref": "#/backend/entities/LocalizedString" },
        "author": { "$ref": "#/backend/entities/LocalizedString" },
        "content": { "$ref": "#/backend/entities/LocalizedString" },
        "placeId": { "type": "string" }
      },
      "required": ["id", "slug", "title", "author", "content"]
    },
    "MenuItem": {
      "title": "Menu Item",
      "description": "An item in the main navigation menu.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "labelKey": { "type": "string", "description": "The key for the translation file (e.g., 'header.places')." },
        "href": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["id", "labelKey", "href", "order"]
    },
    "LocalizedString": {
      "title": "LocalizedString",
      "description": "A string that can be localized into multiple languages.",
      "type": "object",
      "properties": {
        "tr": { "type": "string" },
        "en": { "type": "string" },
        "fr": { "type": "string" },
        "de": { "type": "string" },
        "ja": { "type": "string" }
      },
      "required": ["tr", "en"]
    },
    "Coordinates": {
      "title": "Coordinates",
      "description": "Geographical coordinates.",
      "type": "object",
      "properties": {
        "lat": { "type": "number" },
        "lng": { "type": "number" }
      },
      "required": ["lat", "lng"]
    },
    "SiteStats": {
      "title": "Site Stats",
      "type": "object",
      "properties": {
        "visitorCount": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": [
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "Stores user profile information."
    },
    "/places": {
      "schema": { "$ref": "#/backend/entities/Place" },
      "description": "Collection of all places of interest."
    },
    "/feedbacks": {
      "schema": { "$ref": "#/backend/entities/Feedback" },
      "description": "Collection of user feedbacks for places."
    },
    "/feedback": {
      "schema": { "$ref": "#/backend/entities/CommentFeedback" },
      "description": "General guestbook messages."
    },
    "/backups": {
      "schema": { "type": "object" },
      "description": "Stores database backups before operations."
    },
    "/routes": {
      "schema": { "$ref": "#/backend/entities/Route" },
      "description": "Collection of all thematic routes."
    },
    "/experience-items": {
      "schema": { "$ref": "#/backend/entities/ExperienceItem" },
      "description": "Collection of items for the 'A Day in Salihli' experience menu."
    },
    "/stories": {
      "schema": { "$ref": "#/backend/entities/Story" },
      "description": "Collection of all stories and legends."
    },
    "/menu-items": {
      "schema": { "$ref": "#/backend/entities/MenuItem" },
      "description": "Collection of main navigation menu items."
    },
    "/settings/stats": {
       "schema": { "$ref": "#/backend/entities/SiteStats" },
       "description": "Global website statistics like visitor count."
    }
  }
}
