rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Allow if the user's email is the admin email
      return request.auth != null && request.auth.token.email == 'admin@salihli.bel.tr';
    }

    // AUTHENTICATION
    // ---
    // Logged in users can read and create their own user profile.
    // They can only update their own profile.
    match /users/{userId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth.uid == userId;
      allow delete: if false; // Profiles cannot be deleted
    }

    // CONTENT
    // ---
    // All users can read public content.
    // Only admins can write content.
    match /places/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
     match /routes/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /stories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /brochures/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /menu-items/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
