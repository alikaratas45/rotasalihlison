rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // AUTHENTICATION
    // ---
    // Logged in users can read and create their own user profile.
    // They can only update their own profile.
    match /users/{userId} {
      allow read, create: if request.auth != null;
      allow update: if request.auth.uid == userId;
      allow delete: if false; // Profiles cannot be deleted
    }

    // CONTENT
    // ---
    // All users can read public content.
    // No one can write from the client.
    match /places/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /routes/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /stories/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /brochures/{document=**} {
      allow read: if true;
      allow write: if false;
    }
     match /menu-items/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
